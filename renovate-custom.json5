// Repo-owned Renovate rules, extended last from the generated renovate.json5.
{
  // helm/valkey/charts/valkey is upstream's published chart, re-vendored by
  // the upstream sync (vendir.yml): Renovate bumps the version there, never a
  // file in the vendored tree. ignorePaths replaces the preset's list, so its
  // entries are repeated.
  ignorePaths: [
    '.github/workflows/zz_generated.*',
    '.github/workflows/codeql-analysis.yml',
    '.github/workflows/pre_commit_*.yaml',
    'helm/valkey/charts/**',
  ],
}
